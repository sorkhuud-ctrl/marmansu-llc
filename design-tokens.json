{
  "meta": {
    "siteName": "marmansu-llc",
    "visualDirection": "japanese-corporate-premium",
    "motionLevel": 1,
    "defaultLocale": "en",
    "locales": ["en", "mn", "ja"]
  },
  "colors": {
    "brand": {
      "navy": "#1a2f4a",
      "navyDark": "#0f1c2d",
      "navyLight": "#2a4566",
      "gold": "#c9b896",
      "goldLight": "#e8dfcc"
    },
    "neutral": {
      "white": "#ffffff",
      "gray50": "#f8f9fa",
      "gray100": "#f1f3f5",
      "gray200": "#e9ecef",
      "gray400": "#adb5bd",
      "gray600": "#6c757d",
      "gray800": "#343a40",
      "gray900": "#212529"
    },
    "semantic": {
      "background": "#ffffff",
      "foreground": "#1a2f4a",
      "card": "#ffffff",
      "cardForeground": "#1a2f4a",
      "popover": "#ffffff",
      "popoverForeground": "#1a2f4a",
      "primary": "#1a2f4a",
      "primaryForeground": "#ffffff",
      "secondary": "#f8f9fa",
      "secondaryForeground": "#1a2f4a",
      "muted": "#f1f3f5",
      "mutedForeground": "#6c757d",
      "accent": "#c9b896",
      "accentForeground": "#1a2f4a",
      "border": "#e9ecef",
      "input": "#e9ecef",
      "ring": "#c9b896",
      "success": "#2f855a",
      "warning": "#d69e2e",
      "destructive": "#c53030"
    }
  },
  "typography": {
    "families": {
      "display": "Inter",
      "body": "Inter",
      "mono": "JetBrains Mono",
      "japanese": "Noto Sans JP"
    },
    "scale": {
      "xs": 12,
      "sm": 13,
      "base": 14,
      "md": 15,
      "lg": 16,
      "xl": 18,
      "2xl": 20,
      "3xl": 24,
      "4xl": 28,
      "5xl": 36,
      "6xl": 52,
      "7xl": 64,
      "8xl": 72
    },
    "lineHeight": {
      "tight": 1.1,
      "snug": 1.2,
      "normal": 1.6,
      "relaxed": 1.7,
      "loose": 1.8
    },
    "letterSpacing": {
      "tight": -1,
      "normal": 0,
      "wide": 2,
      "wider": 3,
      "widest": 4
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "scale": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64,
      "4xl": 80,
      "5xl": 96,
      "6xl": 120
    },
    "layout": {
      "pageMaxWidth": 1280,
      "contentPadding": [16, 24, 32, 48, 64, 80, 96, 120],
      "sectionGap": 96,
      "containerPadding": 120
    }
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "shadows": {
    "card": "0 2px 8px rgba(26,47,74,0.06)",
    "cardHover": "0 8px 24px rgba(26,47,74,0.10)",
    "soft": "0 4px 16px rgba(26,47,74,0.08)",
    "hero": "0 8px 32px rgba(26,47,74,0.12)"
  },
  "motion": {
    "duration": {
      "fast": 0.15,
      "normal": 0.2,
      "slow": 0.4,
      "reveal": 0.6
    },
    "easing": {
      "default": "ease-out",
      "smooth": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "variants": {
      "fadeInUp": {
        "initial": { "opacity": 0, "y": 20 },
        "animate": { "opacity": 1, "y": 0 },
        "transition": { "duration": 0.6, "ease": "easeOut" }
      },
      "fadeIn": {
        "initial": { "opacity": 0 },
        "animate": { "opacity": 1 },
        "transition": { "duration": 0.4, "ease": "easeOut" }
      },
      "staggerContainer": {
        "animate": { "transition": { "staggerChildren": 0.1 } }
      },
      "cardHover": {
        "rest": { "y": 0, "boxShadow": "0 2px 8px rgba(26,47,74,0.06)" },
        "hover": { "y": -4, "boxShadow": "0 8px 24px rgba(26,47,74,0.10)" },
        "transition": { "duration": 0.25, "ease": "easeOut" }
      },
      "buttonHover": {
        "rest": { "scale": 1 },
        "hover": { "scale": 1.02 },
        "transition": { "duration": 0.2, "ease": "easeOut" }
      }
    }
  }
}
