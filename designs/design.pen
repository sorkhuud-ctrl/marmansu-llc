:"$font-display","fontSize":36,"fontWeight":"600","id":"B90ieM","name":"Title","textAlign":"center","textGrowth":"fixed-width","type":"text","width":800},{"content":"Partner with MARMANSU to bring Japanese healthcare excellence to Mongolia.","fill":"$gray-400","fontFamily":"$font-body","fontSize":18,"fontWeight":"normal","id":"Oj47x","lineHeight":1.6,"name":"Description","textAlign":"center","textGrowth":"fixed-width","type":"text","width":700},{"children":[{"content":"Contact MARMANSU","fill":"$navy","fontFamily":"$font-body","fontSize":14,"fontWeight":"600","id":"e9VSXW","name":"Label","type":"text"}],"cornerRadius":"$radius-sm","fill":"$white","gap":8,"id":"y3BeV","name":"CTA Button","padding":[16,32],"type":"frame"}],"fill":"$navy","gap":24,"id":"nnL1r","layout":"vertical","name":"CTA Section","padding":[96,120],"type":"frame","width":"fill_container"},{"id":"mGHeh","name":"Footer","ref":"w7DXV","type":"ref","width":"fill_container"}],"clip":true,"id":"AVweg","layout":"vertical","name":"Option C — Global Bridge","type":"frame","width":1440,"x":4440,"y":-2280},{"children":[{"id":"JLUs4","name":"Header","ref":"k2V9MH","type":"ref","width":"fill_container"},{"children":[{"content":"ABOUT MARMANSU","fill":"$gold","fontFamily":"$font-body","fontSize":13,"fontWeight":"600","id":"JLBgL","letterSpacing":2,"name":"Label","type":"text"},{"content":"More Than Products","fill":"$navy","fontFamily":"$font-display","fontSize":52,"fontWeight":"600","id":"UsLFt","lineHeight":1.2,"name":"Title","textGrowth":"fixed-width","type":"text","width":800}],"fill":"$surface-soft","gap":16,"id":"cxlrH","layout":"vertical","name":"Page Hero","padding":[80,120],"type":"frame","width":"fill_container"},{"children":[{"cornerRadius":"$radius-lg","fill":"$gray-200","height":420,"id":"uJ4uR","name":"About Image","type":"frame","width":520},{"children":[{"content":"MARMANSU LLC is a Mongolia–Japan healthcare bridge company founded in 2024. We are not a traditional importer or distributor. We connect Japanese healthcare quality with Mongolia through products, education, medical networks, and long-term partnerships.","fill":"$text-primary","fontFamily":"$font-body","fontSize":18,"fontWeight":"normal","id":"f7Gzcw","lineHeight":1.8,"name":"Paragraph 1","textGrowth":"fixed-width","type":"text","width":"fill_container"},{"content":"Our mission is to create sustainable healthcare solutions rather than simply supplying products. We work with Japanese pharmaceutical companies, medical device manufacturers, dental technology providers, academic institutions, and Mongolian healthcare organizations to build lasting value.","fill":"$text-secondary","fontFamily":"$font-body","fontSize":16,"fontWeight":"normal","id":"EWyvh","lineHeight":1.8,"name":"Paragraph 2","textGrowth":"fixed-width","type":"text","width":"fill_container"},{"content":"Trust, Quality, Professionalism, and Long-term Partnership are the foundations of everything we do.","fill":"$text-secondary","fontFamily":"$font-body","fontSize":16,"fontWeight":"normal","id":"QsNRO","lineHeight":1.8,"name":"Paragraph 3","textGrowth":"fixed-width","type":"text","width":"fill_container"}],"gap":24,"id":"xTWZ7","layout":"vertical","name":"About Text","type":"frame","width":620}],"fill":"$surface","gap":80,"id":"ePKNb","name":"About Content","padding":[96,120],"type":"frame","width":"fill_container"},{"children":[{"descendants":{"IYgv8":{"content":"What Guides Us"},"g8LNma":{"content":"OUR VALUES"},"npN1p":{"content":"These principles shape every partnership we build."}},"id":"V3eU3","name":"Section Heading","ref":"otA88","type":"ref","width":720},{"children":[{"descendants":{"J9uX4":{"content":"Trust"},"Z8s7E":{"content":"We build relationships based on transparency and reliability."}},"id":"qlR9u","name":"Value Trust","ref":"QhjyF","type":"ref","width":"fill_container"},{"descendants":{"J9uX4":{"content":"Quality"},"Z8s7E":{"content":"We prioritize Japanese standards and evidence-based healthcare."}},"id":"uuKbO","name"